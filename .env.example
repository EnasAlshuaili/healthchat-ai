# Copy to .env for local overrides. Never commit .env.
# The MVP uses no external APIs, so no secrets are required.

# Path to the original, unmodified dataset (relative to project root)
QUERYMATE_RAW_DATA=data/raw/Doctor-HealthCare-100k.csv

# Maximum accepted question length in characters
QUERYMATE_MAX_INPUT_CHARS=1000

# Chat logs are not stored. Leave disabled unless storage is separately designed, approved and disclosed (FR-14).
QUERYMATE_STORE_CHATS=false
